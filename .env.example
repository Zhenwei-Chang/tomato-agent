# Copy values into your local environment; do not commit real credentials.
OPENAI_API_KEY=
OPENAI_MODEL=
# OPENAI_BASE_URL=

# DeepSeek may be configured directly, or by pointing to the existing local
# credential file. Keep that file outside this repository.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_ENV_FILE=/absolute/path/outside/repository/.env.deepseek

# Full local execution can override the sibling research project and raw data.
# Offline Replay does not use either setting.
# TOMATO_RESEARCH_ROOT=/absolute/path/to/tomato_multimodal_public
# TOMATO_RAW_ROOT=/absolute/path/to/read-only/public-dataset

# Pytest real-provider tests remain skipped unless explicitly enabled.
TOMATO_ONLINE_TESTS=0
